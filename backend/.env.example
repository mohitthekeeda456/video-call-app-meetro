PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/meetro
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=2h

# Gmail SMTP sender for OTP emails. Use a Gmail app password, not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=meetro.videomeetings.auth@gmail.com
SMTP_FROM=meetro.videomeetings.auth@gmail.com
SMTP_PASS=replace-with-gmail-app-password

# Development-only workaround for local machines with a self-signed certificate chain.
# Keep this false or remove it in production.
SMTP_ALLOW_SELF_SIGNED=false
